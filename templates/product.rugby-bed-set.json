        "fq2": { "type": "faq_item", "settings": { "question": "Does the Rugby Divan Bed come with a headboard?", "answer": "<p>Yes — every Klawford Rugby Divan Bed includes a matching upholstered headboard in your chosen colour as standard. No extra charge.</p>" } },

        "fq4": { "type": "faq_item", "settings": { "question": "How long does delivery take?", "answer": "<p>Standard delivery is 7–14 working days. Our 2-man delivery team will contact you to arrange a convenient date and time slot. Assembly is included at no extra cost.</p>" } },
        "fq5": { "type": "faq_item", "settings": { "question": "What mattress sizes fit the Rugby Divan Base?", "answer": "<p>The Rugby Divan Base is available in Small Single 2FT6, Single 3FT, Small Double 4FT, Double 4FT6, King 5FT, and Super King 6FT — covering all standard UK mattress sizes.</p>" } }

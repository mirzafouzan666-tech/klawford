        "f2": { "type": "feature", "settings": { "image_src": "https://cdn.shopify.com/s/files/1/0960/5588/6153/files/PragueDivanBedPlushVelvetBlackDrawer_1164x_db4d9c5d-20e6-4476-b149-393b82a1039c.webp", "title": "Extra Storage Option For More Space", "description": "<p>Make the most of your bedroom with the San Diego's optional drawer storage. Choose from 2 drawers on the left or right side to keep your bedroom organised and clutter-free.</p>" } },
        "f3": { "type": "feature", "settings": { "image_src": "https://cdn.shopify.com/s/files/1/0960/5588/6153/files/Prague_Divan_Bed_Naples_Slate_grey_Drawer_1164x_64599a18-1b11-4b70-a8e9-d4f587bc7ce7.jpg", "title": "Sustainably Sourced & Handmade in The UK", "description": "<p>Every Klawford San Diego Divan is handcrafted in Britain using sustainably sourced timber and premium plush velvet upholstery — built to last a lifetime and designed to impress.</p>" } },
        "f4": { "type": "feature", "settings": { "image_src": "https://cdn.shopify.com/s/files/1/0960/5588/6153/files/PragueDivanBedPlushVelvetMoccaDrawer_1164x_7b6b57a5-8d4b-4525-ab74-c2b0a75b2b05.webp", "title": "Customisable & Beautiful Headboards", "description": "<p>The San Diego comes with a stunning plush velvet upholstered headboard as standard, perfectly matched to your chosen fabric colour to create a seamless, luxury bedroom look.</p>" } },
        "f5": { "type": "feature", "settings": { "image_src": "https://cdn.shopify.com/s/files/1/0960/5588/6153/files/WhatsApp_Image_2026-07-16_at_6.56.58_PM.jpeg", "title": "Compatible With All Mattress Types", "description": "<p>The San Diego Divan base works perfectly with memory foam, pocket spring, hybrid, latex and orthopaedic mattresses — giving you total freedom to choose your ideal sleep surface.</p>" } }

    "product_faq": {
      "type": "faq",
      "settings": {
        "heading": "Frequently Asked Questions"
      },
      "blocks": {
        "q1": {
          "type": "faq_item",
          "settings": {
            "question": "Do your products conform to UK fire safety regulations?",
            "answer": "<p>Yes — all Klawford products fully comply with UK fire safety regulations including BS 7177. Our factory holds all required certifications.</p>"
          }
        },
        "q2": {
          "type": "faq_item",
          "settings": {
            "question": "How long does delivery take once I've placed my order?",
            "answer": "<p>Standard delivery is 7–14 working days. You'll receive full tracking information once dispatched. Our 2-man team will contact you to arrange a convenient delivery slot.</p>"
          }
        },
        "q3": {
          "type": "faq_item",
          "settings": {
            "question": "Can I choose my delivery date and time?",
            "answer": "<p>Yes — once your order is ready to dispatch, our delivery partner will contact you to arrange a convenient date and time window that suits you.</p>"
          }
        },
        "q4": {
          "type": "faq_item",
          "settings": {
            "question": "Can I place my order over the phone?",
            "answer": "<p>Yes — our sleep specialists are available to take your order by phone. Call us at 0800 000 0000 and we'll guide you through the options and handle your order directly.</p>"
          }
        },
        "q5": {
          "type": "faq_item",
          "settings": {
            "question": "What is the 60-night risk-free trial?",
            "answer": "<p>We're so confident in our products that we offer a 60-night risk-free trial. If you're not completely satisfied within the first 60 nights, contact us for a full refund or free replacement — no questions asked.</p>"
          }
        },
        "q6": {
          "type": "faq_item",
          "settings": {
            "question": "What does the 5-year warranty cover?",
            "answer": "<p>Our 5-year warranty covers all manufacturing defects, structural issues and material faults including the gas-lift mechanism. Contact our customer service team with your order number and we'll handle your claim promptly.</p>"
          }
        },
        "q7": {
          "type": "faq_item",
          "settings": {
            "question": "Can I pay monthly or through financing options?",
            "answer": "<p>Yes — we offer 0% interest financing through Klarna and other providers at checkout. Split your purchase into manageable monthly instalments with no hidden fees.</p>"
          }
        },
        "q8": {
          "type": "faq_item",
          "settings": {
            "question": "Where are your products manufactured?",
            "answer": "<p>All Klawford products are handcrafted in the United Kingdom using sustainably sourced materials. We're proud to support British manufacturing.</p>"
          }
        }
      },

    "product_features": {
      "type": "product-features",
      "settings": {
        "heading": "Why Choose The Klawford Cairo Ottoman?"
      },
      "blocks": {
        "f1": {
          "type": "feature",
          "settings": {
            "image_src": "https://cdn.shopify.com/s/files/1/0960/5588/6153/files/ec62fc7bd29ca5f85a71eacefc22a3e1.jpg",
            "title": "60 Night Risk-Free Trial",
            "description": "<p>We're so confident you'll love your Cairo bed that we offer a full 60-night risk-free trial. Not satisfied within the first 60 nights? Contact us for a hassle-free return or swap — no questions asked.</p>"
          }
        },
        "f2": {
          "type": "feature",
          "settings": {
            "image_src": "https://cdn.shopify.com/s/files/1/0960/5588/6153/files/Grey-WhatsApp_Image_2026-08-12_at_10.21.22_AM.jpeg",
            "title": "Extra Storage Space For More Room",
            "description": "<p>Make the most of your bedroom with the Cairo Ottoman. The full-width gas-lift base opens to reveal a spacious under-bed compartment, perfect for storing bedding, pillows and more — completely hidden from view.</p>"
          }
        },
        "f3": {
          "type": "feature",
          "settings": {
            "image_src": "https://cdn.shopify.com/s/files/1/0960/5588/6153/files/Red-WhatsApp_Image_2026-08-12_at_9.51.52_AM_1.jpeg",
            "title": "Gas-Lift Opening Mechanism",
            "description": "<p>Experience effortless storage with the Cairo's smooth gas-lift mechanism. One gentle lift raises the entire mattress platform, giving you instant access to the full-depth storage compartment below.</p>"
          }
        },
        "f4": {
          "type": "feature",
          "settings": {
            "image_src": "https://cdn.shopify.com/s/files/1/0960/5588/6153/files/image_6.jpg",
            "title": "Sustainably Sourced & Handmade in The UK",
            "description": "<p>Every Klawford Cairo Ottoman is handcrafted in Britain using sustainably sourced timber and premium upholstery fabrics, built to last and designed to impress.</p>"
          }
        },
        "f5": {
          "type": "feature",
          "settings": {
            "image_src": "https://cdn.shopify.com/s/files/1/0960/5588/6153/files/image_2.jpg",
            "title": "Compatible With All Mattress Types",
            "description": "<p>The Cairo Ottoman base works perfectly with memory foam, pocket spring, hybrid, latex and orthopaedic mattresses, giving you total freedom to choose your ideal sleep surface.</p>"
          }
        }
      },
      "block_order": [
        "f1",
        "f2",
        "f3",
        "f4",
        "f5"
      ]
    },
